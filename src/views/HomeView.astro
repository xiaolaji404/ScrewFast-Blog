---
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/landing/HeroSection.astro';
import HeroSectionAlt from '@components/sections/landing/HeroSectionAlt.astro';
import ClientsSection from '@components/sections/landing/ClientsSection.astro';
import FeaturesGeneral from '@components/sections/features/FeaturesGeneral.astro';
import FeaturesNavs from '@components/sections/features/FeaturesNavs.astro';
import TestimonialsSection from '@components/sections/testimonials/TestimonialsSection.astro';
import PricingSection from '@components/sections/pricing/PricingSection.astro';
import FAQ from '@components/sections/misc/FAQ.astro';
import AnnouncementBanner from '@components/ui/banners/AnnouncementBanner.astro';
import heroImage from '@images/hero-image.avif';
import featureImage from '@images/features-image.avif';
import aerialView from '@images/aerial-view.avif';
import tools from '@images/automated-tools.avif';
import dashboard from '@images/dashboard-image.avif';
import { partnersData } from '@data/constants';
import { getCopy } from '@/copy';
import { localePath, type MarketingLocale } from '@utils/locale';

/**
 * ── 首页视图：“用积木拼页面”的典型例子 ──────────────────────────────
 *
 * 【一个页面的三段式（全站所有页面都遵守）】
 *   1. src/pages/index.astro     一行壳：负责 URL ↔ 视图的映射
 *   2. src/views/HomeView.astro  本文件：选区块 + 取文案 + 传数据
 *   3. src/components/sections/… 区块（积木）：自己负责渲染成什么样子
 *
 * 【本文件怎么工作】
 *   - 页面文字不在本文件硬编码，而是从文案表 t.home 取（改文字 → 改 @/copy/zh.ts）
 *   - JSON 数据（faqs/features/pricing）通过 t.data 拿到
 *   - 图片 import 后作为 prop 传给区块
 *   - 区块从上到下的书写顺序 = 页面从上到下的渲染顺序：
 *     想调整版面？直接调换下面这些区块的顺序即可。
 *
 * 【想删掉某个区块？】
 *   删掉它的 import 和对应的 <XxxSection /> 标签即可，比如不想要“价格”就删 PricingSection。
 */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const copy = t.home;

const avatarSrcs: Array<string> = [
  'https://images.unsplash.com/photo-1568602471122-7832951cc4c5?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80',
  'https://images.unsplash.com/photo-1531927557220-a9e23c1e4794?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80',
  'https://images.unsplash.com/photo-1541101767792-f9b2b1c4f127?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&&auto=format&fit=facearea&facepad=3&w=300&h=300&q=80',
  'https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80',
];

const testimonials = copy.testimonials.quotes.map(quote => ({
  ...quote,
  avatarSrc:
    'https://images.unsplash.com/photo-1593104547489-5cfb3839a3b5?q=80&w=1453&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D8&auto=format&fit=facearea&facepad=2&w=320&h=320&q=80',
}));
---

<MainLayout>
  <AnnouncementBanner
    btnId="dismiss-button"
    btnTitle={copy.banner}
    url={localePath(locale, '/blog')}
  />

  <HeroSection
    title={copy.hero.title}
    subTitle={copy.hero.subTitle}
    primaryBtn={copy.hero.primaryBtn}
    primaryBtnURL={localePath(locale, '/blog')}
    secondaryBtn={copy.hero.secondaryBtn}
    secondaryBtnURL={localePath(locale, '/contact')}
    withReview={true}
    avatars={avatarSrcs}
    rating={copy.hero.rating}
    starCount={4}
    reviews={copy.hero.reviews}
    src={heroImage}
    alt={copy.hero.imageAlt}
  />

  <ClientsSection
    title={copy.clients.title}
    subTitle={copy.clients.subTitle}
    partners={partnersData}
  />

  <FeaturesGeneral
    title={copy.featuresGeneral.title}
    subTitle={copy.featuresGeneral.subTitle}
    src={featureImage}
    alt={copy.featuresGeneral.imageAlt}
    features={t.data.features}
  />

  <FeaturesNavs
    title={copy.featuresNavs.title}
    tabs={[
      {
        ...copy.featuresNavs.tabs.tools,
        svg: 'tools',
        src: tools,
        first: true,
      },
      {
        ...copy.featuresNavs.tabs.dashboard,
        svg: 'dashboard',
        src: dashboard,
        second: true,
      },
      {
        ...copy.featuresNavs.tabs.features,
        svg: 'house',
        src: aerialView,
      },
    ]}
  />

  <TestimonialsSection
    title={copy.testimonials.title}
    subTitle={copy.testimonials.subTitle}
    testimonials={testimonials}
    statistics={copy.testimonials.statistics}
  />

  <PricingSection pricing={t.data.pricing} />

  <FAQ title={copy.faqTitle} faqs={t.data.faqs} />

  <HeroSectionAlt
    title={copy.heroAlt.title}
    subTitle={copy.heroAlt.subTitle}
    url={localePath(locale, '/contact')}
  />
</MainLayout>
