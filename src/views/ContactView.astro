---
import MainLayout from '@/layouts/MainLayout.astro';
import ContactSection from '@components/sections/misc/ContactSection.astro';
import { getCopy } from '@/copy';
import type { MarketingLocale } from '@utils/locale';

/**
 * ── 联系页视图 ──────────────────────────────────────────────────
 *
 * 页面主体只有一块：ContactSection（联系方式与表单）。
 * 表单是演示用的 DemoForm（不连后端），接入真实服务的方法见 docs/development.md。
 */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const copy = getCopy(locale).contact;
---

<MainLayout
  title={copy.title}
  description={copy.metaDescription}
  ogTitle={copy.ogTitle}
>
  <ContactSection />
</MainLayout>
