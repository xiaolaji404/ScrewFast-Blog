---
import MainLayout from '@/layouts/MainLayout.astro';
import InsightDetail from '@components/sections/insights/InsightDetail.astro';
import type { CollectionEntry } from 'astro:content';
import { localeOf } from '@utils/content';
import { getCopy } from '@/copy';

/**
 * ── 随想（insights）详情页视图 ─────────────────────────────────────
 *
 * 与博客文章类似，但“页面类型”是 Article（拿不到作者/发布日期信息），
 * 详情区块 InsightDetail 会额外渲染目录与阅读进度条。
 */
interface Props {
  post: CollectionEntry<'insights'>;
}

const { post } = Astro.props;
const locale = localeOf(post);
const t = getCopy(locale);
---

<MainLayout
  title={post.data.title}
  description={post.data.description}
  section={t.insights.ogSection}
  kind={{ type: 'Article', image: post.data.cardImage.src }}
>
  <InsightDetail post={post} />
</MainLayout>
