---
import { SITE } from '@data/constants';

/**
 * 站点标识：一颗“流星”图形 + 站点名称（取自 SITE.title）。
 * 想换成自己的图形时，直接替换下面的 <svg> 即可。
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center gap-2 font-bold tracking-tight text-neutral-800 dark:text-neutral-200',
    className,
  ]}
>
  <svg
    class="size-7 shrink-0 text-yellow-500 dark:text-yellow-400"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="15.5" cy="8.5" r="3.5" fill="currentColor" stroke="none" />
    <path d="M10.6 13.4 3.4 20.6"></path>
    <path d="M13.4 16.6 8.4 21.6"></path>
    <path d="M8 10.6 2.6 16"></path>
  </svg>
  <span class="text-xl leading-none">{SITE.title}</span>
</span>