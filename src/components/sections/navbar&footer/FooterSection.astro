---
import FooterSocialLink from '@components/ui/links/FooterSocialLink.astro';
import EmailFooterInput from '@components/ui/forms/input/EmailFooterInput.astro';
import DemoForm from '@components/ui/forms/DemoForm.astro';
import Icon from '@components/ui/icons/Icon.astro';
import BrandLogo from '@components/BrandLogo.astro';
import { FILINGS, SITE } from '@data/constants';
import { footerSections, socialLinks } from '@data/navigation';
import { localePath } from '@utils/locale';

const { locale, copy: t } = Astro.locals;
const footer = t.nav.footer;

const socialIconClass =
  'h-4 w-4 shrink-0 text-neutral-700 dark:text-neutral-400';

// 备案链接样式（比版权行更轻，保持页脚层次感）
const filingLinkClass =
  'rounded-lg ring-zinc-500 outline-hidden transition duration-300 hover:text-neutral-700 hover:underline hover:underline-offset-2 focus-visible:ring-3 dark:ring-zinc-200 dark:hover:text-neutral-300 dark:focus:outline-hidden';
---

<footer class="w-full bg-neutral-300 dark:bg-neutral-900">
  <div class="mx-auto w-full max-w-[85rem] px-4 py-10 sm:px-6 lg:px-16 lg:pt-20 2xl:max-w-(--breakpoint-2xl)">
    <div class="grid grid-cols-2 gap-6 md:grid-cols-4 lg:grid-cols-5">
      <div class="col-span-full lg:col-span-1">
        {/* Brand Logo */}
        <BrandLogo />
      </div>
      {/* Link sections from the copy table (Ecosystem, Company, …) */}
      {footerSections.map(section => (
        <div class="col-span-1">
          <h3 class="font-bold text-neutral-800 dark:text-neutral-200">
            {footer.sectionTitles[section.id]}
          </h3>
          <ul class="mt-3 grid space-y-3">
            {section.links.map(link => (
              <li>
                <a
                  href={localePath(locale, link.path)}
                  class="inline-flex gap-x-2 rounded-lg text-neutral-600 ring-zinc-500 outline-hidden transition duration-300 hover:text-neutral-500 focus-visible:ring-3 dark:text-neutral-400 dark:ring-zinc-200 dark:hover:text-neutral-300 dark:focus:outline-hidden"
                >
                  {footer.links[link.id]}
                </a>
                {link.badge === 'hiring' ? (
                  <span class="ms-1 inline rounded-lg bg-orange-500 px-2 py-1 text-xs font-bold text-neutral-50">
                    {footer.hiringBadge}
                  </span>
                ) : null}
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="col-span-2">
        <h3 class="font-bold text-neutral-800 dark:text-neutral-200">
          {footer.stayUpToDate}
        </h3>

        <DemoForm successMessage={footer.newsletterDemoMessage}>
          <EmailFooterInput />
          <p class="mt-3 text-sm text-neutral-600 dark:text-neutral-400">
            {footer.stayUpToDateContent}
          </p>
        </DemoForm>
      </div>
    </div>

    <div class="mt-9 grid gap-y-2 sm:mt-12 sm:flex sm:items-center sm:justify-between sm:gap-y-0">
      {/* 版权行 + 备案信息（左侧一列，上下两行） */}
      <div class="flex flex-col gap-y-2">
        <p class="text-sm text-neutral-600 dark:text-neutral-400">
          © <span id="current-year"></span>
          {` `}
          {SITE.title}。{footer.craftedBy}
        </p>
        {/* 大陆站点备案号：均为指向官方查询页的外链，号码定义在 @data/constants 的 FILINGS */}
        <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-neutral-500 dark:text-neutral-400">
          <a
            class={filingLinkClass}
            href={FILINGS.icp.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            {FILINGS.icp.number}
          </a>
          <a
            class={filingLinkClass}
            href={FILINGS.police.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            {FILINGS.police.number}
          </a>
        </p>
      </div>

      {/* Social Brands */}
      <div>
        <FooterSocialLink url={socialLinks.facebook} label="Facebook">
          <Icon name="facebook" class={socialIconClass} title="Facebook" />
        </FooterSocialLink>

        <FooterSocialLink url={socialLinks.x} label="X">
          <Icon name="x" class={socialIconClass} title="X" />
        </FooterSocialLink>

        <FooterSocialLink url={socialLinks.github} label="GitHub">
          <Icon name="githubMark" class={socialIconClass} title="GitHub" />
        </FooterSocialLink>

        <FooterSocialLink url={socialLinks.google} label="Google">
          <Icon name="google" class={socialIconClass} title="Google" />
        </FooterSocialLink>

        <FooterSocialLink url={socialLinks.slack} label="Slack">
          <Icon name="slack" class={socialIconClass} title="Slack" />
        </FooterSocialLink>
      </div>
    </div>

    <script>
      const year = new Date().getFullYear();
      const element = document.getElementById('current-year');
      element!.innerText = year.toString();
    </script>
  </div>
</footer>
