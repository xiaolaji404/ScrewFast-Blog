---
import { SITE } from '@data/constants';
import type { Props } from '@astrojs/starlight/props';

const main = '/';
const locale = Astro.props.locale ? Astro.props.locale + '/' : '';
const docs = '/' + locale + 'welcome-to-docs/';
---

<span class="site-title flex">
  <a class="main-logo" href={main} aria-label={SITE.title}>
    <span class="site-title-text">{SITE.title}</span>
  </a>
  <a class="docs-logo" href={docs} aria-label="文档">
    <span class="site-title-text">文档</span>
  </a>
</span>

<style>
  .site-title {
    gap: 0.75rem;
    margin-right: 1rem;
  }
  .site-title a {
    display: flex;
    align-items: center;
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .site-title-text {
    white-space: nowrap;
    line-height: 1;
  }
  .site-title .docs-logo .site-title-text {
    font-weight: 400;
    opacity: 0.75;
  }
  .site-title a:focus-visible {
    outline: 0;
  }
  .site-title a:focus-visible > :global(*) {
    transform: translateY(calc(0.1rem * -1));
    transition: transform 250ms cubic-bezier(0.33, 1, 0.68, 1);
  }
  .site-title a:hover > :global(*) {
    transform: translateY(calc(0.1rem * -1));
    transition: transform 250ms cubic-bezier(0.33, 1, 0.68, 1);
  }
</style>
