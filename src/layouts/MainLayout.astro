---
import Meta from '@components/Meta.astro';
import Navbar from '@components/sections/navbar&footer/Navbar.astro';
import FooterSection from '@components/sections/navbar&footer/FooterSection.astro';
import { buildPageMetadata, type PageKind } from '@utils/metadata';
import '@styles/global.css';

/**
 * ── 全站唯一的页面布局：每个页面的“外壳” ────────────────────────────
 *
 * 【类比】
 *   如果把一个页面看作一幅画：
 *     画框（导航栏 + 页脚 + <head>）← 本文件统一提供，全站一致
 *     画的内容                       ← 各视图写在 <MainLayout>…</MainLayout> 里面
 *   所以任何页面都不用重复写导航栏、页脚和 SEO 标签。
 *
 * 【它做三件事】
 *   1. 生成 <head>：把页面提供的 title/description/kind 交给 buildPageMetadata()，
 *      推导出标题、描述、Open Graph、canonical、JSON-LD 等全部 SEO 元数据，
 *      再由 Meta.astro 渲染。
 *   2. 组织页面结构：Navbar（顶栏）+ <slot/>（页面内容）+ Footer（页脚）。
 *   3. 加载全站脚本与样式：Tailwind 主样式、Lenis 平滑滚动、Preline 交互组件、
 *      暗色模式切换。
 *
 * 【页面怎么用它】
 *   页面只告诉它“我是什么”，而不是“怎么展示”：
 *     title/description  → 标题与 SEO 描述
 *     section            → OG 标题的中间段（如“博客”）
 *     kind               → 页面类型（WebPage/BlogPosting/Article/Product），决定 JSON-LD
 *     hideFooter         → 个别页面（如 404）可以不要页脚
 *   语言不需传入：middleware 已把它挂在 Astro.locals.locale 上。
 */
interface Props {
  /** Page title without the site suffix. Omit on the home page. */
  title?: string;
  description?: string;
  ogTitle?: string;
  /** Site section for the OG title, e.g. `copy.blog.ogSection`. */
  section?: string;
  kind?: PageKind;
  hideFooter?: boolean;
}

const {
  title,
  description,
  ogTitle,
  section,
  kind,
  hideFooter = false,
} = Astro.props;
const { locale, copy: t } = Astro.locals;

const metadata = buildPageMetadata({
  locale,
  pathname: Astro.url.pathname,
  title,
  description,
  ogTitle,
  section,
  kind,
});
---

<html
  lang={metadata.lang}
  class="scrollbar-hide lenis lenis-smooth scroll-pt-16"
>
  <head>
    <Meta metadata={metadata} />
    <script is:inline>
      // Script to handle dark mode. It will check if the theme is stored in localStorage or if dark theme is preferred by system settings
      if (
        localStorage.getItem('hs_theme') === 'dark' ||
        (!('hs_theme' in localStorage) &&
          window.matchMedia('(prefers-color-scheme: dark)').matches)
      ) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
    <script>
      import '@scripts/lenisSmoothScroll.js';
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-neutral-200 selection:bg-yellow-400 selection:text-neutral-700 dark:bg-neutral-800">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-100 focus:rounded-lg focus:bg-yellow-400 focus:px-4 focus:py-2 focus:text-neutral-800"
    >
      {t.layout.skipToContent}
    </a>
    {/*
    Setting up the main structure of the page.
    The Navbar is placed at the top, with a slot for the main content and FooterSection at the bottom.
    */}
    <div class="mx-auto w-full max-w-(--breakpoint-2xl) grow px-4 sm:px-6 lg:px-8">
      <Navbar />
      <main id="main-content">
        <slot />
      </main>
    </div>
    {!hideFooter && <FooterSection />}
    <script>
      // https://preline.co
      import 'preline';
      const init = () =>
        (
          window as Window & { HSStaticMethods?: { autoInit?: () => void } }
        ).HSStaticMethods?.autoInit?.();
      if (document.readyState === 'loading')
        document.addEventListener('DOMContentLoaded', init);
      else init();
    </script>
    <style>
      /* CSS rules for the page scrollbar */
      .scrollbar-hide::-webkit-scrollbar {
        display: none;
      }

      .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
  </body>
</html>
